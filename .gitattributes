# Normalise line endings so a Windows checkout and a Linux checkout produce
# identical files, and `git status` stops warning about CRLF on every commit.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf

# Windows-only scripts keep CRLF so they run under cmd.exe.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Never touch binaries.
*.png   binary
*.zip   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.db    binary
